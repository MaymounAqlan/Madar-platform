APP_ENV=production
PORT=8000
REDIS_URL=redis://default:PLACEHOLDER@redis.railway.internal:6379
CACHE_ENABLED=true
NIXPACKS_APT_PKGS=tesseract-ocr,poppler-utils
# Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
# File Limits
MAX_FILE_SIZE_MB=10
# CORS
CORS_ORIGINS=https://frontend.up.railway.app,https://backend.up.railway.app
