# ============================================
# MADAR Platform - Root Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# Node Environment
NODE_ENV=production
ENVIRONMENT=production

# Frontend
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGO_ROOT_USER=
MONGO_ROOT_PASS=
MONGODB_URI=mongodb://admin:YOUR_PASSWORD@mongodb:27017/madar?authSource=admin

# Redis
REDIS_URL=redis://redis:6379

# JWT (generate strong random strings for production)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# AI Service
AI_SERVICE_URL=http://ai-engine:8000
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Matching Algorithm Weights (must sum to 1.0)
MATCH_SKILLS_WEIGHT=0.6
MATCH_EXPERIENCE_WEIGHT=0.2
MATCH_PROJECTS_WEIGHT=0.1
MATCH_SEMANTIC_WEIGHT=0.1

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Swagger
SWAGGER_ENABLED=true

# Logging
LOG_LEVEL=INFO
