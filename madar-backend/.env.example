# Server
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://frontend.up.railway.app

# Database
MONGODB_URI=mongodb://mongo:PLACEHOLDER@mongo.railway.internal:27017/madar
MONGODB_POOL_SIZE=10

# JWT
JWT_SECRET=PLACEHOLDER_SECRET_KEY
JWT_REFRESH_SECRET=PLACEHOLDER_REFRESH_KEY
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=PLACEHOLDER_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=PLACEHOLDER_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://backend.up.railway.app/api/auth/google/callback

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=PLACEHOLDER_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=PLACEHOLDER_LINKEDIN_CLIENT_SECRET
LINKEDIN_CALLBACK_URL=https://backend.up.railway.app/api/auth/linkedin/callback

# Optional: Email service
SMTP_HOST=PLACEHOLDER_SMTP_HOST
SMTP_PORT=587
SMTP_USER=PLACEHOLDER_SMTP_USER
SMTP_PASS=PLACEHOLDER_SMTP_PASS

# Optional: File upload
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=5242880

# Development/test data only. Never enable in production.
ENABLE_TEST_SEED=false
TEST_ACCOUNT_DEFAULT_PASSWORD=

# Optional: Google Gemini API key for PDF study-plan import
GEMINI_API_KEY=PLACEHOLDER_GEMINI_API_KEY

# AI engine and asynchronous processing
AI_SERVICE_URL=https://ai.up.railway.app
AI_REQUEST_TIMEOUT=30000
AI_MAX_RETRIES=3
AI_JOB_TIMEOUT=120000
REDIS_URL=redis://default:PLACEHOLDER@redis.railway.internal:6379
MATCH_SKILLS_WEIGHT=0.60
MATCH_EXPERIENCE_WEIGHT=0.20
MATCH_PROJECTS_WEIGHT=0.10
MATCH_SEMANTIC_WEIGHT=0.10
MATCH_THRESHOLD=60
HIGH_MATCH_THRESHOLD=80
