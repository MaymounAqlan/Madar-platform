{
  "name": "madar-backend",
  "version": "1.0.0",
  "description": "MADAR Platform - AI-Powered Recruitment Backend",
  "author": "MADAR Team",
  "private": true,
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed:yemen-universities": "ts-node -r tsconfig-paths/register src/database/seeds/import-yemen-universities.ts --apply --download-logos",
    "seed:yemen-universities:dry-run": "ts-node -r tsconfig-paths/register src/database/seeds/import-yemen-universities.ts --dry-run",
    "migrate:student-academics": "ts-node -r tsconfig-paths/register src/database/migrations/migrate-student-academic-references.ts --apply",
    "migrate:student-academics:dry-run": "ts-node -r tsconfig-paths/register src/database/migrations/migrate-student-academic-references.ts --dry-run",
    "cleanup:demo-universities": "ts-node -r tsconfig-paths/register src/database/migrations/cleanup-demo-universities.ts --apply",
    "cleanup:demo-universities:dry-run": "ts-node -r tsconfig-paths/register src/database/migrations/cleanup-demo-universities.ts --dry-run",
    "verify:academic-directory": "ts-node -r tsconfig-paths/register src/database/migrations/verify-academic-directory.ts",
    "reconcile:academic-orphans": "ts-node -r tsconfig-paths/register src/database/migrations/reconcile-orphan-academic-references.ts --apply",
    "reconcile:academic-orphans:dry-run": "ts-node -r tsconfig-paths/register src/database/migrations/reconcile-orphan-academic-references.ts --dry-run",
    "merge:legacy-universities": "ts-node -r tsconfig-paths/register src/database/migrations/merge-exact-legacy-universities.ts --apply",
    "merge:legacy-universities:dry-run": "ts-node -r tsconfig-paths/register src/database/migrations/merge-exact-legacy-universities.ts --dry-run",
    "seed:test-accounts": "ts-node -r tsconfig-paths/register src/database/seeds/seed-test-accounts.ts",
    "seed:test-accounts:cleanup": "ts-node -r tsconfig-paths/register src/database/seeds/cleanup-test-accounts.ts"
  },
  "dependencies": {
    "@nestjs/bull": "^10.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.2",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express-session": "^1.19.0",
    "form-data": "^4.0.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.1.13",
    "resend": "^6.18.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.11",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.0",
    "@types/passport-google-oauth20": "^2.0.0",
    "@types/passport-jwt": "^4.0.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
